---
import type { Locale } from '@/lib/i18n';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  keywords?: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  image = 'https://umamusumedb.com/og-image.png',
  canonicalURL = Astro.url.href,
  type = 'website',
  keywords = 'uma musume, pretty derby, umamusume database, ウマ娘, プリティーダービー, support cards, tier list, training calculator, character stats',
  locale = 'en',
  alternates
} = Astro.props;

const fullTitle = title.includes('UmamusumeDB') ? title : `${title} | UmamusumeDB`;

const ogLocaleMap: Record<Locale, string> = {
  en: 'en_US',
  ja: 'ja_JP',
  zh: 'zh_CN'
};

const ogLocale = ogLocaleMap[locale] ?? ogLocaleMap.en;
const availableLocales = Array.from(
  new Set<Locale>([
    ...(alternates ? (Object.keys(alternates) as Locale[]) : []),
    locale
  ])
);
const ogAlternates = availableLocales
  .filter((key) => key !== locale)
  .map((key) => ogLocaleMap[key])
  .filter(Boolean);

const hrefEn = alternates?.en ?? canonicalURL;
const hrefJa = alternates?.ja;
const hrefZh = alternates?.zh;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="UmamusumeDB" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="UmamusumeDB" />
<meta property="og:locale" content={ogLocale} />
{ogAlternates.map((alt) => (
  <meta property="og:locale:alternate" content={alt} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:site" content="@umamusumedb" />
<meta property="twitter:creator" content="@umamusumedb" />

<!-- Additional SEO Meta Tags -->
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="UmamusumeDB" />
<meta name="application-name" content="UmamusumeDB" />
<meta name="msapplication-TileColor" content="#4F46E5" />
<meta name="theme-color" content="#4F46E5" />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://img.umamusumedb.com" />
<link rel="dns-prefetch" href="https://img.umamusumedb.com" />

<!-- Language alternatives -->
<link rel="alternate" hreflang="en" href={hrefEn} />
{hrefJa && <link rel="alternate" hreflang="ja" href={hrefJa} />}
{hrefZh && <link rel="alternate" hreflang="zh-Hans" href={hrefZh} />}
<link rel="alternate" hreflang="x-default" href={hrefEn} />
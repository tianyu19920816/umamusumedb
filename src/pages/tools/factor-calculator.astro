---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import FactorCalculator from '@/components/tools/FactorCalculator';
---

<Layout
  title="Factor Inheritance Calculator - UmamusumeDB"
  description="Calculate factor inheritance probabilities and optimize your breeding strategy in Uma Musume"
  structuredDataType="tool"
  structuredData={{
    name: 'Factor Inheritance Calculator',
    description: 'Calculate factor inheritance probabilities and optimize your breeding strategy in Uma Musume.',
    url: '/tools/factor-calculator/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Factor Calculator' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">Factor Inheritance Calculator</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Calculate inheritance probabilities and plan breeding efficiently.
      </p>
    </div>

    <FactorCalculator client:load />
  </main>
</Layout>
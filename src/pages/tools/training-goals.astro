---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import TrainingGoals from '@/components/tools/TrainingGoals';
---

<Layout
  title="Training Goals Tracker - UmamusumeDB"
  description="Track and manage training goals for each Uma Musume character"
  structuredDataType="tool"
  structuredData={{
    name: 'Training Goals Tracker',
    description: "Track your progress through each character's training goals and get tips for completing them.",
    url: '/tools/training-goals/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Training Goals' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">Training Goals Tracker</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Track character-specific goals and get practical tips for each checkpoint.
      </p>
    </div>

    <TrainingGoals client:load />
  </main>
</Layout>
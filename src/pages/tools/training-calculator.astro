---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import TrainingCalculator from '@/components/tools/TrainingCalculator';
---

<Layout
  title="Training Calculator - UmamusumeDB"
  description="Calculate optimal training paths and maximize stat gains in Uma Musume"
  structuredDataType="tool"
  structuredData={{
    name: 'Training Calculator',
    description: 'Calculate optimal training paths and maximize stat gains in Uma Musume.',
    url: '/tools/training-calculator/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Training Calculator' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">Training Calculator</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Plan your training schedule and estimate gains with different support setups.
      </p>
    </div>

    <TrainingCalculator client:load />
  </main>
</Layout>
---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SupportDeckBuilder from '@/components/tools/SupportDeckBuilder';
---

<Layout
  title="Support Deck Builder - UmamusumeDB"
  description="Build optimal support card decks for different training strategies in Uma Musume"
  structuredDataType="tool"
  structuredData={{
    name: 'Support Deck Builder',
    description: 'Build optimal support card decks for different training strategies in Uma Musume.',
    url: '/tools/support-deck/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Support Deck Builder' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">Support Deck Builder</h1>
      <p class="text-sm sm:text-base text-gray-600">
        Draft a 6-card deck quickly and compare templates by goal (distance + style).
      </p>
    </div>

    <SupportDeckBuilder client:load />
  </main>
</Layout>
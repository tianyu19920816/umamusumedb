---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import TrainingGoals from '@/components/tools/TrainingGoals';
---

<Layout
  title="目標管理 - ウマ娘DB"
  description="キャラ別の目標レースを確認し、達成のコツをメモできるツール"
  structuredDataType="tool"
  structuredData={{
    name: '目標管理',
    description: 'キャラ別の目標レースを確認し、達成のコツをメモできるツール',
    url: '/ja/tools/training-goals/'
  }}
>
  <Header />

  <main class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
    <Breadcrumb items={[{ label: 'ツール', href: '/ja/tools/' }, { label: '目標管理' }]} />

    <div class="mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3 sm:mb-4">育成目標トラッカー</h1>
      <p class="text-sm sm:text-base text-gray-600">
        育成の目標レースを把握し、必要ステータスやスキルの目安を確認できます。
      </p>
    </div>

    <TrainingGoals client:load />
  </main>
</Layout>




